<?xml version="1.0" encoding="utf-8"?>
<!--
  The Day Dial's needle as a level-driven rotation (DayDialWidget): level 0 is
  midnight, 10000 a full turn, about the dial's centre on the 364×382 canvas
  (182/364 = 50 %, 189/382 = 49.4764 %). ImageView.setImageLevel is remotable,
  so the minute tick moves it in a partial update without resending the face.
-->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/day_dial_needle_up"
    android:fromDegrees="0"
    android:toDegrees="360"
    android:pivotX="50%"
    android:pivotY="49.4764%" />
