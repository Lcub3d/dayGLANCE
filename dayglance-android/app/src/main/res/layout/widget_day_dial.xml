<?xml version="1.0" encoding="utf-8"?>
<!-- Day Dial, the dial alone: a placement with no room for the cards
     (DialArrangement). The dial is widget_day_dial_box.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_dial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_day_dial_background"
    android:padding="4dp">

    <include
        layout="@layout/widget_day_dial_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
