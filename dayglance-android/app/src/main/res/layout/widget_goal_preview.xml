<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview for the Goal widget (widget_goal_info.xml
  previewLayout).

  widget_goal.xml as GoalWidget.bindGoalViews leaves it for a pinned goal:
  colour bar, title with the days-left badge, the threshold progress bar
  (65% shows the amber bar only), "pct · done/total" stats, the projects
  divider, two active project rows (goal-coloured bar, done/total, mini
  progress bar), the completed separator, and one completed row (green bar,
  green "✓ Done", no progress bar). The stale banner and the not-configured
  state are left out.

  Inflated as RemoteViews: TextView hairlines and colour bars, never <View>.
  Sample text lives in values*/widget_preview_strings.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- ── Header ────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pill_goal"
                android:textColor="@color/widget_brand"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:gravity="end"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_refresh"
                android:padding="5dp"
                android:contentDescription="@string/action_refresh" />

        </LinearLayout>

        <!-- Hairline divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider"
            android:layout_marginBottom="6dp"
            android:text="" />

        <!-- ── Goal content ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Goal card: colored left bar + details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#10b981"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title + due-date row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/widget_preview_goal_title"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/widget_preview_goal_due"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Progress bar row (amber: 40–79%) + stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="65"
                            android:progressTint="#f59e0b"
                            android:progressBackgroundTint="#33f59e0b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65%  ·  11/17"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Projects divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider"
                android:layout_marginBottom="4dp"
                android:text="" />

            <!-- Active project row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="7dp"
                    android:background="#10b981"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_goal_project1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="7/12"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:max="100"
                    android:progress="58"
                    android:progressTint="@color/widget_brand"
                    android:progressBackgroundTint="@color/widget_ring_track" />

            </LinearLayout>

            <!-- Active project row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="7dp"
                    android:background="#10b981"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_goal_project2"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1/2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/widget_brand"
                    android:progressBackgroundTint="@color/widget_ring_track" />

            </LinearLayout>

            <!-- Completed-projects separator -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:text="" />

            <!-- Completed project row: green bar, "✓ Done", no progress bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="7dp"
                    android:background="#22c55e"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_goal_project3"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_done_check"
                    android:textColor="#22c55e"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
