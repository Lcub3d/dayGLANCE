<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview for the Project widget (widget_project_info.xml
  previewLayout).

  widget_project.xml as ProjectWidget.bindProjectViews leaves it for a pinned
  project: parent-goal chip, colour bar and title, the threshold progress bar
  (50% shows the amber bar only), "done/total · pct" stats, the tasks divider
  and four task rows, open ○ first then done ✓. The stale banner and the
  not-configured state are left out.

  Inflated as RemoteViews: TextView hairlines and colour bars, never <View>.
  Sample text lives in values*/widget_preview_strings.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- ── Header ────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pill_project"
                android:textColor="@color/widget_brand"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_refresh"
                android:padding="5dp"
                android:contentDescription="@string/action_refresh" />

        </LinearLayout>

        <!-- Hairline divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider"
            android:layout_marginBottom="6dp"
            android:text="" />

        <!-- ── Project content ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Parent goal chip -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/widget_preview_project_goal"
                android:textColor="@color/widget_committed_text"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_committed_pill"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Project card: colored left bar + vertical details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#f59e0b"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_project_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Progress bar row + stats (amber: 40–79%) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="#f59e0b"
                            android:progressBackgroundTint="#33f59e0b"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2/4  ·  50%"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Tasks divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider"
                android:layout_marginBottom="3dp"
                android:text="" />

            <!-- Task row 1 (open) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="16dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp" android:text="○"
                    android:textSize="11sp" android:textColor="@color/widget_text_secondary" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/widget_preview_project_task1"
                    android:textSize="12sp" android:textColor="@color/widget_text_primary"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <!-- Task row 2 (open) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="16dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp" android:text="○"
                    android:textSize="11sp" android:textColor="@color/widget_text_secondary" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/widget_preview_project_task2"
                    android:textSize="12sp" android:textColor="@color/widget_text_primary"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <!-- Task row 3 (done) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="16dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp" android:text="✓"
                    android:textSize="11sp" android:textColor="@color/widget_text_secondary" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/widget_preview_project_task3"
                    android:textSize="12sp" android:textColor="@color/widget_text_primary"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

            <!-- Task row 4 (done) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="16dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp" android:text="✓"
                    android:textSize="11sp" android:textColor="@color/widget_text_secondary" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/widget_preview_project_task4"
                    android:textSize="12sp" android:textColor="@color/widget_text_primary"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
