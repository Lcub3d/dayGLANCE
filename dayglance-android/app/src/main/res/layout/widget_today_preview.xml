<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview for the Today widget (widget_info.xml previewLayout).

  The live layout (widget_layout.xml) is an empty card until
  DayGlanceWidgetListFactory fills its ListView, and a collection view renders
  nothing in a preview. This is the same card with the list replaced by static
  rows that copy widget_item_section / widget_item_frame_header /
  widget_item_task as the factory binds them:

    ALL DAY pill · all-day task (ALL DAY badge)
    SCHEDULED pill · frame header (name, range, free time)
      · two indented frame tasks on the frame background
        (one IN PROGRESS, one with a project chip and the tall bar)
    · one unframed task

  Inflated as RemoteViews: TextView hairlines and colour bars, never <View>.
  Sample text lives in values*/widget_preview_strings.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- ── Header: date + last-updated timestamp ────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_updated"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_widget_refresh"
                android:padding="5dp"
                android:contentDescription="@string/action_refresh" />

        </LinearLayout>

        <!-- Hairline divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider"
            android:layout_marginBottom="4dp"
            android:text="" />

        <!-- ── Static agenda rows ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Section: ALL DAY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_all_day"
                    android:textColor="@color/widget_section_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_section_pill" />

            </LinearLayout>

            <!-- All-day task: short bar, ALL DAY badge, no time line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:background="#ec4899"
                    android:layout_marginEnd="7dp"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/widget_preview_today_allday_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_all_day"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Section: SCHEDULED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_scheduled"
                    android:textColor="@color/widget_section_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_section_pill" />

            </LinearLayout>

            <!-- Frame header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="3dp"
                android:background="@color/widget_frame_bg">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:background="#8b5cf6"
                    android:layout_marginEnd="7dp"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_today_frame_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_frame_times"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_frame_free"
                        android:textColor="@color/widget_brand"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Frame task 1: indented, frame background, IN PROGRESS badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="14dp"
                android:paddingEnd="0dp"
                android:background="@color/widget_frame_bg">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:background="#3b82f6"
                    android:layout_marginEnd="7dp"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/widget_preview_today_task1_title"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/badge_in_progress"
                            android:textColor="@color/widget_in_progress_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task1_time"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- Frame task 2: indented, project chip, tall bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="14dp"
                android:paddingEnd="0dp"
                android:background="@color/widget_frame_bg">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="44dp"
                    android:background="#f59e0b"
                    android:layout_marginEnd="7dp"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task2_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task2_project"
                        android:textColor="@color/widget_committed_text"
                        android:textSize="10sp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/widget_committed_pill"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task2_time"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- Unframed task: flush left, transparent background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:background="#10b981"
                    android:layout_marginEnd="7dp"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task3_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_preview_today_task3_time"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
