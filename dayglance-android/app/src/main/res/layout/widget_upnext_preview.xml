<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview for the Up Next widget (widget_upnext_info.xml
  previewLayout).

  widget_upnext.xml as UpNextWidget.bindTaskViews leaves it for a populated
  task: colour bar, title with the time-until badge, time range, project chip,
  tags line, then the subtask divider and two subtask rows (one done ✓, one
  open ○). The stale banner, notes preview and empty state are left out.

  Inflated as RemoteViews: TextView hairlines and colour bars, never <View>.
  Sample text lives in values*/widget_preview_strings.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pill_up_next"
                android:textColor="@color/widget_brand"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:gravity="end"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_refresh"
                android:padding="5dp"
                android:contentDescription="@string/action_refresh" />

        </LinearLayout>

        <!-- Hairline divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider"
            android:layout_marginBottom="6dp"
            android:text="" />

        <!-- ── Task content ────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left color bar -->
            <TextView
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:minHeight="24dp"
                android:background="#8b5cf6"
                android:text="" />

            <!-- Right: task details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title + time-until badge row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/widget_preview_upnext_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/widget_preview_upnext_time_until"
                        android:textColor="@color/widget_brand"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Time range line -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/widget_preview_upnext_time"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Project chip -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/widget_preview_upnext_project"
                    android:textColor="@color/widget_committed_text"
                    android:textSize="10sp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:background="@drawable/widget_committed_pill"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Tags line -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/widget_preview_upnext_tags"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Subtasks divider -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="3dp"
                    android:background="@color/widget_divider"
                    android:text="" />

                <!-- Subtask row 1 (done) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="✓"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_secondary" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/widget_preview_upnext_sub1"
                        android:textSize="12sp"
                        android:textColor="@color/widget_text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Subtask row 2 (open) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="○"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_secondary" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/widget_preview_upnext_sub2"
                        android:textSize="12sp"
                        android:textColor="@color/widget_text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
