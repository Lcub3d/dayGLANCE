<?xml version="1.0" encoding="utf-8"?>
<!--
  The month grid widget's palette, dark (the reference mockup's, and the iOS
  MonthPalette's dark side). Light is res/values/widget_month_colors.xml.
  The layouts read these directly; MonthGridCellPainter reads both sides
  (MonthCellPalette, through a light and a night configuration context) so
  each cell carries a bitmap for either theme and the launcher switches
  between them with no redraw (layout-night/widget_month_cell.xml).
-->
<resources>
    <color name="month_widget_background">#FF161b22</color>
    <color name="month_widget_date">#FF8b949e</color>
    <color name="month_widget_date_emphasis">#FFc9d1d9</color>
    <color name="month_widget_muted">#FF6e7681</color>
    <color name="month_widget_hairline">#FF30363d</color>
    <color name="month_widget_today_fill">#FF1f6feb</color>
    <!-- The app's brand orange: the one combined pip, and the all-day pip. -->
    <color name="month_widget_pip">#FFfe8b00</color>
    <!-- The deadline pip where the cell is wide enough for two. -->
    <color name="month_widget_pip_deadline">#FFf85149</color>
    <!-- The stale banner: iOS's system orange in dark mode (StaleBanner). -->
    <color name="month_widget_stale">#FFff9f0a</color>
</resources>
