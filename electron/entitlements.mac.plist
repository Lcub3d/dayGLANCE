<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron for the V8 JIT compiler under Hardened Runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required by Electron to load its own unsigned helper code -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Outbound network access (CalDAV, AI APIs, WebSocket, etc.) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read access to the system Calendar via the EventKit helper -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Microphone capture for voice input: getUserMedia in the renderer (AI
         transcription) and the bundled speech helper (on-device recognition).
         Required under Hardened Runtime: without it the TCC grant is recorded,
         the app appears in Privacy & Security › Microphone, and the capture
         itself is still refused. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- iCloud entitlements are NOT needed for the Developer ID build: the app
         is unsandboxed and accesses the iCloud container via a plain file path.
         They will be added to a separate entitlements.mas.plist for the future
         Mac App Store build, which requires sandboxing. -->
  </dict>
</plist>
